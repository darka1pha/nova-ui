{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "docs",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@darkalpha/nova-docs",
        "exec",
        "vite",
        "--port",
        "5173",
        "--strictPort"
      ],
      "port": 5173
    },
    {
      "name": "example",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "--prefix",
        "examples/vite-app",
        "vite",
        "examples/vite-app",
        "--port",
        "5180",
        "--strictPort"
      ],
      "port": 5180
    }
  ]
}