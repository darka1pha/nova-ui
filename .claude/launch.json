{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "docs",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@darkalpha/nova-docs",
        "exec",
        "vite",
        "--port",
        "5173",
        "--strictPort"
      ],
      "port": 5173
    },
    {
      "name": "docs-alt",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@darkalpha/nova-docs",
        "exec",
        "vite",
        "--port",
        "5174",
        "--strictPort"
      ],
      "port": 5174
    },
    {
      "name": "example",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "--prefix",
        "examples/vite-app",
        "vite",
        "examples/vite-app",
        "--port",
        "5180",
        "--strictPort"
      ],
      "port": 5180
    },
    {
      "name": "next-example",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "examples/next-app",
        "run",
        "dev",
        "--",
        "--port",
        "5190"
      ],
      "port": 5190
    },
    {
      "name": "docs-preview",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@darkalpha/nova-docs",
        "exec",
        "vite",
        "preview",
        "--port",
        "4173",
        "--strictPort"
      ],
      "port": 4173
    }
  ]
}
