{
  "name": "@darkalpha/nova-tokens",
  "version": "0.5.1",
  "description": "Design tokens, color engine and theme definitions for the Nova UI design system. Framework-agnostic.",
  "license": "MIT",
  "author": "DarkAlpha",
  "homepage": "https://github.com/darka1pha/nova-ui#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/darka1pha/nova-ui.git",
    "directory": "packages/tokens"
  },
  "bugs": {
    "url": "https://github.com/darka1pha/nova-ui/issues"
  },
  "keywords": [
    "design-tokens",
    "design-system",
    "oklch",
    "color",
    "theme",
    "wcag",
    "contrast",
    "dtcg"
  ],
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./css/tokens.css": "./dist/css/tokens.css",
    "./css/themes.css": "./dist/css/themes.css",
    "./css/tailwind.css": "./dist/css/tailwind.css",
    "./tokens.json": "./dist/tokens.json",
    "./tokens.dtcg.json": "./dist/tokens.dtcg.json",
    "./dtcg/*": "./dist/dtcg/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/build-css.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "generate:primitives": "node scripts/generate-primitives.ts"
  },
  "devDependencies": {
    "vitest": "^5.0.5"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
