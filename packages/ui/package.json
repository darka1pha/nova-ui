{
  "name": "@darkalpha/nova-ui",
  "version": "0.3.4",
  "description": "Colorful, accessible, themeable React components for the Nova UI design system.",
  "license": "MIT",
  "author": "DarkAlpha",
  "homepage": "https://github.com/darka1pha/nova-ui#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/darka1pha/nova-ui.git",
    "directory": "packages/ui"
  },
  "bugs": {
    "url": "https://github.com/darka1pha/nova-ui/issues"
  },
  "keywords": [
    "react",
    "components",
    "design-system",
    "ui",
    "accessible",
    "a11y",
    "theme",
    "tailwind",
    "radix"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./icons": {
      "types": "./dist/icons/index.d.ts",
      "default": "./dist/icons/index.js"
    },
    "./icons/catalog": {
      "types": "./dist/icons/catalog.d.ts",
      "default": "./dist/icons/catalog.js"
    },
    "./react-hook-form": {
      "types": "./dist/react-hook-form.d.ts",
      "default": "./dist/react-hook-form.js"
    },
    "./rich-text-editor": {
      "types": "./dist/rich-text-editor.d.ts",
      "default": "./dist/rich-text-editor.js"
    },
    "./styles.css": "./dist/styles.css",
    "./themes.css": "./dist/themes.css",
    "./tailwind.css": "./dist/tailwind.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "generate": "node scripts/generate-css.ts",
    "build": "node scripts/generate-css.ts && tsc -p tsconfig.build.json && node scripts/annotate-pure.ts && node scripts/build-css.ts",
    "typecheck": "node scripts/generate-css.ts && tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "size": "node scripts/size-report.ts"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0",
    "react-hook-form": "^7.55.0"
  },
  "dependencies": {
    "@darkalpha/nova-tokens": "workspace:^",
    "@tiptap/core": "^3.32.2",
    "@tiptap/extension-bubble-menu": "^3.32.2",
    "@tiptap/extension-highlight": "^3.32.2",
    "@tiptap/extension-image": "^3.32.2",
    "@tiptap/extension-list": "^3.32.2",
    "@tiptap/extension-subscript": "^3.32.2",
    "@tiptap/extension-superscript": "^3.32.2",
    "@tiptap/extension-table": "^3.32.2",
    "@tiptap/extension-text-align": "^3.32.2",
    "@tiptap/extension-text-style": "^3.32.2",
    "@tiptap/extension-typography": "^3.32.2",
    "@tiptap/extensions": "^3.32.2",
    "@tiptap/pm": "^3.32.2",
    "@tiptap/react": "^3.32.2",
    "@tiptap/starter-kit": "^3.32.2",
    "@tiptap/suggestion": "^3.32.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.63.0",
    "radix-ui": "^1.8.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@hookform/resolvers": "^6.0.2",
    "@tailwindcss/cli": "^4.3.3",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.2",
    "axe-core": "^4.14.0",
    "jsdom": "^30.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "zod": "^4.6.7"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependenciesMeta": {
    "react-hook-form": {
      "optional": true
    }
  }
}
